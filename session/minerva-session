}

# ------------------------------------------- mask XFCE parts we replace
# xfce4-session autostarts its own panel/desktop/power-manager; Minerva
# replaces all three. Hidden=true in the user autostart dir disables an XDG
# autostart entry per spec — boring, standard, no patches involved.
mask_autostart() {
  AD="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
  mkdir -p "$AD" 2>/dev/null || return 0
  for d in xfce4-panel xfdesktop; do
    cat >"$AD/$d.desktop" <<EOF
[Desktop Entry]
Hidden=true
X-Minerva-Override=masked by the Minerva session
EOF
  done
  log "xfce autostart overrides written to $AD"
}

# ------------------------------------------------------- openbox fallback cfg
write_openbox_config() {
  OB_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/openbox"
  mkdir -p "$OB_DIR"
  if [ -f "$OB_DIR/rc.xml" ] && ! grep -q "minerva-generated" "$OB_DIR/rc.xml" 2>/dev/null; then
    cp "$OB_DIR/rc.xml" "$OB_DIR/rc.xml.pre-minerva" 2>/dev/null
  fi
  cat >"$OB_DIR/rc.xml" <<RCEOF
<?xml version="1.0" encoding="UTF-8"?>
<!-- minerva-generated: rewritten at every login by /usr/bin/minerva-session -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance><strength>10</strength><screen_edge_strength>20</screen_edge_strength></resistance>
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse><focusLast>yes</focusLast><raiseOnFocus>yes</raiseOnFocus></focus>
  <theme><name>Minerva</name><titleLayout>C</titleLayout><keepBorder>yes</keepBorder><hideDisabled>no</hideDisabled><animateIconify>no</animateIconify></theme>
  <desktops><number>4</number><firstdesk>1</firstdesk><names><name>1</name><name>2</name><name>3</name><name>4</name></names></desktops>
  <resize><popupShow>Nonpixel</popupShow><popupPosition>Center</popupPosition></resize>
  <margins><top>0</top><bottom>0</bottom><left>0</left><right>0</right></margins>
  <keyboard>
    <keybind key="A-Tab"><action name="NextWindow"><allDesktops>yes</allDesktops></action></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow"><allDesktops>yes</allDesktops></action></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="Super_L"><action name="Execute"><command>minerva-ctl event launcher</command></action></keybind>
    <keybind key="Super_R"><action name="Execute"><command>minerva-ctl event launcher</command></action></keybind>
    <keybind key="C-A-T"><action name="Execute"><command>minerva-ctl app terminal</command></action></keybind>
    <keybind key="W-e"><action name="Execute"><command>minerva-ctl app files</command></action></keybind>
    <keybind key="W-w"><action name="Execute"><command>minerva-ctl event overview</command></action></keybind>
    <keybind key="W-d"><action name="ToggleShowDesktop"/></keybind>
    <keybind key="W-l"><action name="Execute"><command>minerva-ctl cmd lock</command></action></keybind>
    <keybind key="W-Left"><action name="GoToDesktop"><to>previous</to></action></keybind>
    <keybind key="W-Right"><action name="GoToDesktop"><to>next</to></action></keybind>
  </keyboard>
  <mouse>
    <context name="Frame">
      <mousebind button="A-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></mousebind>
    </context>
  </mouse>
  <applications>
    <application name="minerva-shell" class="minerva-shell">
      <decor>no</decor><layer>below</layer>
      <skip_taskbar>yes</skip_taskbar><skip_pager>yes</skip_pager>
    </application>
    <application title="Minerva">
      <decor>no</decor><layer>below</layer>
      <skip_taskbar>yes</skip_taskbar><skip_pager>yes</skip_pager>
    </application>
  </applications>
</openbox_config>
RCEOF
  if [ -f "$SHAREDIR/openbox/menu.xml" ] && [ ! -f "$OB_DIR/menu.xml" ]; then
    cp "$SHAREDIR/openbox/menu.xml" "$OB_DIR/menu.xml"
  fi
  log "openbox config written to $OB_DIR"
}

# Keeps the fullscreen shell surface pinned no matter which WM is in charge:
# below every app window, fullscreen (geometry pin only while the fullscreen
# state is missing — re-applying -e to a fullscreen window makes the WM
# reconfigure it every tick).
enforce_shell_surface() {
  command -v wmctrl >/dev/null 2>&1 || { log "enforcer: wmctrl missing, skipped"; return 0; }
  command -v xprop >/dev/null 2>&1 || { log "enforcer: xprop missing, skipped"; return 0; }
  sleep 2
  while :; do
    for id in $(xprop -root _NET_CLIENT_LIST 2>/dev/null | tr ',' '\n' | sed -n 's/.*#x\?\([0-9a-fA-F]*\).*/\1/p'); do
      t="$(xprop -id 0x$id _NET_WM_NAME 2>/dev/null | sed -n 's/.*"\(.*\)".*/\1/p' | head -1)"
      if [ "$t" = "Minerva" ]; then
        if [ -f "$RT/locked" ]; then
          wmctrl -i -r 0x"$id" -b remove,below 2>/dev/null
          wmctrl -i -r 0x"$id" -b add,above,skip_taskbar,skip_pager 2>/dev/null
        else
          wmctrl -i -r 0x"$id" -b remove,above 2>/dev/null
          wmctrl -i -r 0x"$id" -b add,below,skip_taskbar,skip_pager 2>/dev/null
        fi
        wmctrl -i -r 0x"$id" -b add,fullscreen 2>/dev/null
        if ! xprop -id 0x"$id" _NET_WM_STATE 2>/dev/null | grep -q FULLSCREEN; then
          wmctrl -i -r 0x"$id" -e 0,0,0,"$SCREEN_W","$SCREEN_H" 2>/dev/null
        fi
      fi
    done
    sleep 3
  done
}

watch_wm() {
  while :; do
    if ! pgrep -x minerva-wm >/dev/null 2>&1 && ! pgrep -x xfwm4 >/dev/null 2>&1 && ! pgrep -x openbox >/dev/null 2>&1; then
      log "no window manager alive — starting xfwm4"
      xfwm4 >>"$LOG" 2>&1 &
    fi
    if pgrep -x xfdesktop >/dev/null 2>&1 || pgrep -x xfce4-panel >/dev/null 2>&1; then
      log "leaked XFCE surface — killing (only the Minerva shell may draw)"
      pkill -x xfdesktop 2>/dev/null
      pkill -x xfce4-panel 2>/dev/null
    fi
    sleep 4
  done
}

shell_start() {
  # one launcher for every base: browser pick, kiosk flags, respawn loop and
  # the loud self-check all live in minerva-shell-start
  log "shell surface via minerva-shell-start"
  minerva-shell-start >>"$LOG" 2>&1 &
  SHELL_START_PID=$!
}

pick_browser() {
  if [ -n "${MINERVA_BROWSER:-}" ] && command -v "$MINERVA_BROWSER" >/dev/null 2>&1; then
    echo "$MINERVA_BROWSER"; return 0
  fi
  for b in chromium chromium-browser firefox-esr firefox epiphany-browser; do
    command -v "$b" >/dev/null 2>&1 && { echo "$b"; return 0; }
  done
  echo ""
}
export MINERVA_BROWSER="$(pick_browser)" MINERVA_SESSION_PID=$$
export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-gtk}"
if [ -z "$MINERVA_BROWSER" ]; then
  if [ "$BASE" = native ] || [ "$BASE" = xfce ] || [ "$BASE" = openbox ]; then
    log "no browser present — the native WM does not need one (legacy shell fallback would be unavailable)"
  else
    echo "Minerva: no browser found. sudo apt install chromium" >&2
    exit 1
  fi
fi

xsetroot -solid '#0b1020' 2>/dev/null

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user import-environment DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP GDK_BACKEND QT_QPA_PLATFORM GTK_USE_PORTAL \
    2>/dev/null || true
fi

pick_legacy() {
  if command -v xfce4-session >/dev/null 2>&1 && command -v xfwm4 >/dev/null 2>&1; then
    echo xfce
  elif command -v openbox >/dev/null 2>&1; then
    echo openbox
  else
    echo kiosk
  fi
}

start_native() {
  log "base: minerva-wm (native X11 WM + compositor)"
  "$WM_BIN" >>"$LOG" 2>&1 &
  BASE_PID=$!
  echo "$BASE_PID" >"$STATE/wm.pid"
  sleep 1
  if ! kill -0 "$BASE_PID" 2>/dev/null; then
    log "minerva-wm exited immediately — retrying once"
    "$WM_BIN" >>"$LOG" 2>&1 &
    BASE_PID=$!
    echo "$BASE_PID" >"$STATE/wm.pid"
  fi
}

start_xfce() {
    log "base: xfce4-session + xfwm4 (wrapper mode)"
    write_xfconf_defaults
    mask_autostart
    xprop -root -remove _NET_NUMBER_OF_DESKTOPS \
          -remove _NET_DESKTOP_NAMES \
          -remove _NET_CURRENT_DESKTOP 2>/dev/null
    xfce4-session >>"$LOG" 2>&1 &
    BASE_PID=$!
    watch_wm &
    WM_WATCH_PID=$!
    enforce_shell_surface &
    ENFORCE_PID=$!
    shell_start
}

start_openbox() {
    log "base: openbox (fallback wrapper mode)"
    mask_autostart
    xprop -root -remove _NET_NUMBER_OF_DESKTOPS \
          -remove _NET_DESKTOP_NAMES \
          -remove _NET_CURRENT_DESKTOP 2>/dev/null
    write_openbox_config
    openbox --sm-disable --startup "minerva-autostart" >>"$LOG" 2>&1 &
    BASE_PID=$!
    echo "$BASE_PID" >"$STATE/wm.pid"
    sleep 0.5
    if ! kill -0 "$BASE_PID" 2>/dev/null; then
      log "openbox exited immediately - retrying once"
      openbox --sm-disable --startup "minerva-autostart" >>"$LOG" 2>&1 &
      BASE_PID=$!
    fi
    enforce_shell_surface &
    ENFORCE_PID=$!
    shell_start
}

start_kiosk() {
    log "base: kiosk single-window ($MINERVA_BROWSER)"
    shell_start
}

start_base() {
  if [ "$BASE" = native ] && [ -z "$WM_BIN" ]; then
    log "minerva-wm binary missing — demoting to legacy base"
    BASE="$(pick_legacy)"
  fi
  case "$BASE" in
    native) start_native ;;
    xfce) start_xfce ;;
    openbox) start_openbox ;;
    *) start_kiosk ;;
  esac
}
start_base

{
  echo "mode=$MINERVA_SESSION_MODE base=$BASE screen=${SCREEN_W}x${SCREEN_H} browser=$MINERVA_BROWSER"
  echo "daemon_pid=$(cat "$PIDFILE" 2>/dev/null) base_pid=$BASE_PID"
  echo "ready_at=$(date '+%Y-%m-%d %H:%M:%S')"
} >"$STATE/ready"

# The base session exiting = logout. Respawn it once if it dies on its feet.
base_tries=0
EXIT_CODE=0
if [ -n "$BASE_PID" ]; then
  while :; do
    wait "$BASE_PID"
    EXIT_CODE=$?
    [ "$EXITING" = yes ] && break
    base_tries=$((base_tries + 1))
    if [ "$base_tries" -ge 2 ]; then
      if [ "$BASE" = native ]; then
        BASE="$(pick_legacy)"
        base_tries=0
        log "minerva-wm failed twice — FAILING OVER to base=$BASE (never silent)"
        {
          echo "$(date '+%F %T') minerva-wm failed to stay up (2 attempts, last exit=$EXIT_CODE); session fell back to base=$BASE."
          echo "  WM stderr captured in: $LOG"
        } >> "$HOME/minerva-report.txt"
        if command -v notify-send >/dev/null 2>&1; then
          notify-send -u critical "Minerva" "Native WM failed twice - fell back to $BASE base" 2>/dev/null || true
        fi
        start_base
        continue
      fi
      log "base session failed $base_tries times — giving up"
      break
    fi
    log "base session exited code=$EXIT_CODE — respawning $BASE (try $base_tries)"
    sleep 1
    start_base
  done
else
  if [ -n "${SHELL_START_PID:-}" ]; then wait "$SHELL_START_PID"; fi
  EXIT_CODE=$?
fi
log "session exit code=$EXIT_CODE"
exit "$EXIT_CODE"
