  TH_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/themes/Minerva/openbox-3"
  mkdir -p "$TH_DIR" 2>/dev/null || return 0
  cat >"$TH_DIR/themerc" <<THEMEEOF
