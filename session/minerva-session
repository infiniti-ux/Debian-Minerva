#!/bin/sh
# minerva-session — Minerva desktop session (v5, native base).
#
# v0.11.0 architecture: minerva-wm — the native Rust X11 window manager and
# compositor — IS the base session AND the shell surface. Panel, taskbar,
# launcher and system menus are native X windows it draws itself; there is
# no browser and no HTML underneath. The 0.6.x wrapper bases survive only
# as loud fail-safes:
#   * base session  : minerva-wm (native WM + COMPOSITE/DAMAGE/RENDER
#                     compositor, EWMH, decorations, panel/dock/launcher);
#   * fallback base : xfce4-session + xfwm4 + browser shell (the 0.6-0.10
#                     wrapper path) — engaged automatically, with a report
#                     line in ~/minerva-report.txt, if minerva-wm is missing
#                     or fails to stay up twice;
#   * fallback base2: openbox + minerva-autostart (the 0.5.x proven path);
#   * last resort   : single kiosk window (cage/weston/no-WM boxes);
#   * minerva-sessiond : Rust daemon — session state, app launching, system
#                     layer (volume, Wi-Fi, resolution, brightness, power);
#   * the shell surface is started DIRECTLY by this script through
#     minerva-shell-start in every base branch (0.6.1+: delegating the launch
#     to XDG autostart proved unreliable), with respawn and a loud
#     self-check inside minerva-shell-start.
set -u

PORT="${MINERVA_PORT:-47801}"
BIND="127.0.0.1"
DAEMON="${MINERVA_DAEMON:-/usr/bin/minerva-sessiond}"
WEBROOT="${MINERVA_WEBROOT:-/usr/share/minerva/web}"
SHAREDIR="${MINERVA_SHAREDIR:-/usr/share/minerva}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/minerva"
mkdir -p "$STATE" 2>/dev/null || STATE="/tmp/minerva-$USER"
mkdir -p "$STATE"
LOG="$STATE/session.log"

RT="${XDG_RUNTIME_DIR:-/tmp}/minerva"
mkdir -p "$RT" && chmod 700 "$RT" 2>/dev/null

# ---- platform contracts: every child (daemon, base, apps) sees Minerva ----
export XDG_CURRENT_DESKTOP=Minerva
export XDG_SESSION_DESKTOP=Minerva
export GDK_BACKEND=x11
export CLUTTER_BACKEND=x11
export QT_QPA_PLATFORM=xcb
export MOZ_ENABLE_WAYLAND=0
export SAL_USE_VCLPLUGIN=gtk3
export GTK_USE_PORTAL=1
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

TOKEN="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || echo "minerva-$$-$(date +%s)")"
URL="http://$BIND:$PORT/?token=$TOKEN"

DAEMON_PID=""
WATCH_PID=""
BASE_PID=""
WM_WATCH_PID=""
ENFORCE_PID=""
EXITING=no
PIDFILE="$STATE/sessiond.pid"

log() { echo "[minerva-session] $*" >>"$LOG"; }

{
  echo "MINERVA_PORT=$PORT"
  echo "MINERVA_TOKEN=$TOKEN"
  echo "MINERVA_API=http://$BIND:$PORT/api/v1"
  echo "XDG_CURRENT_DESKTOP=$XDG_CURRENT_DESKTOP"
} >"$RT/session.env"
chmod 600 "$RT/session.env" 2>/dev/null

# ---------------------------------------------------------------- base choice
# minerva-wm is the primary base; MINERVA_BASE / MINERVA_WM are overrides for
# debugging and for the test suite.
WM_BIN="${MINERVA_WM:-/usr/bin/minerva-wm}"
command -v "$WM_BIN" >/dev/null 2>&1 || WM_BIN=""
MULTIWIN=no
BASE=kiosk
if [ -n "${MINERVA_BASE:-}" ]; then
  BASE="$MINERVA_BASE"
elif [ -n "${DISPLAY:-}" ]; then
  if [ -n "$WM_BIN" ]; then
    BASE=native
  elif command -v xfce4-session >/dev/null 2>&1 && command -v xfwm4 >/dev/null 2>&1; then
    BASE=xfce
  elif command -v openbox >/dev/null 2>&1; then
    BASE=openbox
  fi
fi
case "$BASE" in native|xfce|openbox) MULTIWIN=yes ;; esac
MINERVA_SESSION_MODE="$([ "$MULTIWIN" = yes ] && echo x11 || echo kiosk)"
export MINERVA_SESSION_MODE

SCREEN_W=1920
SCREEN_H=1080
if command -v xrandr >/dev/null 2>&1; then
  dims="$(xrandr 2>/dev/null | awk '/\*/ {print $1; exit}')"
  case "$dims" in *x*) SCREEN_W="${dims%%x*}"; SCREEN_H="${dims##*x}" ;; esac
elif command -v xdpyinfo >/dev/null 2>&1; then
  dims="$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2; exit}')"
  case "$dims" in *x*) SCREEN_W="${dims%%x*}"; SCREEN_H="${dims##*x}" ;; esac
fi
log "screen ${SCREEN_W}x${SCREEN_H} mode=$MINERVA_SESSION_MODE base=$BASE"

start_daemon() {
  "$DAEMON" --port "$PORT" --bind "$BIND" --token "$TOKEN" --web-root "$WEBROOT" >>"$LOG" 2>&1 &
  DAEMON_PID=$!
  echo "$DAEMON_PID" >"$PIDFILE"
  log "daemon started pid=$DAEMON_PID port=$PORT mode=$MINERVA_SESSION_MODE"
}

stop_daemon() {
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
    rm -f "$PIDFILE"
  fi
  [ -n "$DAEMON_PID" ] && kill "$DAEMON_PID" 2>/dev/null
  DAEMON_PID=""
}

cleanup() {
  EXITING=yes
  log "session ending"
  [ -n "$WATCH_PID" ] && kill "$WATCH_PID" 2>/dev/null
  [ -n "$BASE_PID" ] && kill "$BASE_PID" 2>/dev/null
  [ -n "${SHELL_START_PID:-}" ] && kill "$SHELL_START_PID" 2>/dev/null
  [ -n "$WM_WATCH_PID" ] && kill "$WM_WATCH_PID" 2>/dev/null
  [ -n "$ENFORCE_PID" ] && kill "$ENFORCE_PID" 2>/dev/null
  pkill -f "user-data-dir=$RT/shell-" 2>/dev/null
  stop_daemon
  rm -f "$RT/session.env"
  rm -rf "$RT"/shell-* 2>/dev/null
}
trap cleanup EXIT INT TERM

# A session bus is required by the autostarted services (dunst, polkit).
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
  eval "$(dbus-launch --exit-with-session)" 2>/dev/null
  export DBUS_SESSION_BUS_ADDRESS
  log "dbus: no session bus inherited - launched a private one"
fi

for envf in /etc/xdg/openbox/environment "${XDG_CONFIG_HOME:-$HOME/.config}/openbox/environment"; do
  # shellcheck disable=SC1090
  [ -r "$envf" ] && . "$envf"
done

if command -v xrdb >/dev/null 2>&1 && [ -f "$HOME/.Xresources" ]; then
  xrdb -merge "$HOME/.Xresources" 2>/dev/null
fi

export XDG_CURRENT_DESKTOP=Minerva
systemctl --user import-environment DISPLAY XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS 2>/dev/null || true

# ------------------------------------------------------------ daemon (first)
start_daemon
watch_daemon() {
  while :; do
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      log "daemon died — restarting"
      start_daemon
    fi
    sleep 2
  done
}
watch_daemon &
WATCH_PID=$!

i=0
while [ "$i" -lt 50 ]; do
  if command -v curl >/dev/null 2>&1; then
    curl -fsS -o /dev/null "http://$BIND:$PORT/api/v1/health" 2>/dev/null && break
  else
    [ "$i" -ge 10 ] && break
  fi
  i=$((i + 1)); sleep 0.2
done
[ "$i" -lt 50 ] || log "warning: daemon not healthy after 10 s"

# ------------------------------------------------ xfconf per-channel defaults
# Written before xfce4-session starts so the very first login already has
# them (xfconf-query would need the xfconf daemon, which only exists once
# the session is up — a chicken-and-egg the 0.6.0 release walked straight
# into). Only created when absent; user edits always win.
write_xfconf_defaults() {
  XD="${XDG_CONFIG_HOME:-$HOME/.config}/xfce4/xfconf/xfce-perchannel-xml"
  mkdir -p "$XD" 2>/dev/null || return 0
  [ -f "$XD/xfce4-session.xml" ] || cat >"$XD/xfce4-session.xml" <<'XEOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-session" version="1.0">
  <property name="general" type="empty">
    <property name="SaveOnExit" type="bool" value="false"/>
  </property>
</channel>
XEOF
  [ -f "$XD/xfce4-keyboard-shortcuts.xml" ] || cat >"$XD/xfce4-keyboard-shortcuts.xml" <<'XEOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="custom" type="empty">
      <property name="Super_L" type="string" value="minerva-ctl event launcher"/>
      <property name="Super_R" type="string" value="minerva-ctl event launcher"/>
      <property name="&lt;Primary&gt;&lt;Alt&gt;t" type="string" value="minerva-ctl app terminal"/>
      <property name="&lt;Super&gt;e" type="string" value="minerva-ctl app files"/>
      <property name="&lt;Super&gt;w" type="string" value="minerva-ctl event overview"/>
      <property name="&lt;Super&gt;l" type="string" value="minerva-ctl cmd lock"/>
      <property name="override" type="bool" value="true"/>
    </property>
  </property>
</channel>
XEOF
  cat >"$XD/xfwm4.xml" <<'XEOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Minerva"/>
    <property name="button_layout" type="string" value="|HMC"/>
    <property name="placement_mode" type="string" value="mouse"/>
    <property name="use_compositing" type="bool" value="true"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
