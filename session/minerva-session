#!/bin/sh
# minerva-session — Minerva desktop session (v3, single-surface).
#
# Architecture (see docs/PRODUCT.md for the full product roadmap):
#   * minerva-sessiond  : Rust daemon — session state, app launching, system
#                         layer (volume, Wi-Fi, resolution, brightness, power)
#   * openbox           : X11 window manager (EWMH) — manages REAL app windows
#   * ONE fullscreen shell surface (chromium --kiosk) that draws the whole
#     Minerva desktop: wallpaper, top bar, taskbar dock, launcher, popovers,
#     notifications, settings. No per-panel windows, no placement guessing:
#     a kiosk window is fullscreen by itself, everywhere, always.
#   * real applications run as ordinary X clients on top (xterm, pcmanfm,
#     chromium --app, ...), listed in the dock via the EWMH client list.
#
# Fallback: without openbox/DISPLAY the same surface runs kiosk-style under
# cage/weston so the session never dead-ends at a black screen.
set -u

PORT="${MINERVA_PORT:-47801}"
BIND="127.0.0.1"
DAEMON="${MINERVA_DAEMON:-/usr/bin/minerva-sessiond}"
WEBROOT="${MINERVA_WEBROOT:-/usr/share/minerva/web}"
SHAREDIR="${MINERVA_SHAREDIR:-/usr/share/minerva}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/minerva"
mkdir -p "$STATE" 2>/dev/null || STATE="/tmp/minerva-$USER"
mkdir -p "$STATE"
LOG="$STATE/session.log"

RT="${XDG_RUNTIME_DIR:-/tmp}/minerva"
mkdir -p "$RT" && chmod 700 "$RT" 2>/dev/null

TOKEN="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || echo "minerva-$$-$(date +%s)")"
URL="http://$BIND:$PORT/?token=$TOKEN"

DAEMON_PID=""
WATCH_PID=""
SHELL_PID=""
WM_PID=""
ENFORCE_PID=""
WM_WATCH_PID=""
EXITING=no
PIDFILE="$STATE/sessiond.pid"
SHELL_PROFILE="$RT/shell-$$"

log() { echo "[minerva-session] $*" >>"$LOG"; }

{
  echo "MINERVA_PORT=$PORT"
  echo "MINERVA_TOKEN=$TOKEN"
  echo "MINERVA_API=http://$BIND:$PORT/api/v1"
} >"$RT/session.env"
chmod 600 "$RT/session.env" 2>/dev/null

start_daemon() {
  "$DAEMON" --port "$PORT" --bind "$BIND" --token "$TOKEN" --web-root "$WEBROOT" >>"$LOG" 2>&1 &
  DAEMON_PID=$!
  echo "$DAEMON_PID" >"$PIDFILE"
  log "daemon started pid=$DAEMON_PID port=$PORT mode=${MINERVA_SESSION_MODE:-kiosk}"
}

stop_daemon() {
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
    rm -f "$PIDFILE"
  fi
  [ -n "$DAEMON_PID" ] && kill "$DAEMON_PID" 2>/dev/null
  DAEMON_PID=""
}

cleanup() {
  EXITING=yes
  log "session ending"
  [ -n "$WATCH_PID" ] && kill "$WATCH_PID" 2>/dev/null
  [ -n "$SHELL_PID" ] && kill "$SHELL_PID" 2>/dev/null
  [ -n "$WM_PID" ] && kill "$WM_PID" 2>/dev/null
  [ -n "$WM_WATCH_PID" ] && kill "$WM_WATCH_PID" 2>/dev/null
  [ -n "$ENFORCE_PID" ] && kill "$ENFORCE_PID" 2>/dev/null
  pkill -f "user-data-dir=$RT/shell-" 2>/dev/null
  pkill -f "user-data-dir=$RT/panels" 2>/dev/null
  stop_daemon
  rm -f "$RT/session.env"
  rm -rf "$RT"/shell-* 2>/dev/null
}
trap cleanup EXIT INT TERM

pick_browser() {
  if [ -n "${MINERVA_BROWSER:-}" ] && command -v "$MINERVA_BROWSER" >/dev/null 2>&1; then
    echo "$MINERVA_BROWSER"; return 0
  fi
  for b in chromium chromium-browser firefox-esr firefox epiphany-browser; do
    command -v "$b" >/dev/null 2>&1 && { echo "$b"; return 0; }
  done
  echo ""
}

BROWSER="$(pick_browser)"
if [ -z "$BROWSER" ]; then
  echo "Minerva: no browser found. sudo apt install chromium openbox" >&2
  exit 1
fi

# A session bus is required by the autostarted services (dunst, polkit).
# Display managers provide one; start a private bus when they don't
# (same guard every proven X session script carries).
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
  eval "$(dbus-launch --exit-with-session)" 2>/dev/null
  export DBUS_SESSION_BUS_ADDRESS
  log "dbus: no session bus inherited - launched a private one"
fi

# Openbox environment-file convention (system then user), like openbox-session.
for envf in /etc/xdg/openbox/environment "${XDG_CONFIG_HOME:-$HOME/.config}/openbox/environment"; do
  # shellcheck disable=SC1090
  [ -r "$envf" ] && . "$envf"
done

# X resources, like /etc/X11/Xsession does.
if command -v xrdb >/dev/null 2>&1 && [ -f "$HOME/.Xresources" ]; then
  xrdb -merge "$HOME/.Xresources" 2>/dev/null
fi

export XDG_CURRENT_DESKTOP=Minerva
systemctl --user import-environment DISPLAY XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS 2>/dev/null || true

MULTIWIN=no
if [ -n "${DISPLAY:-}" ] && command -v openbox >/dev/null 2>&1; then MULTIWIN=yes; fi

SCREEN_W=1920
SCREEN_H=1080
if command -v xrandr >/dev/null 2>&1; then
  dims="$(xrandr 2>/dev/null | awk '/\*/ {print $1; exit}')"
  case "$dims" in *x*) SCREEN_W="${dims%%x*}"; SCREEN_H="${dims##*x}" ;; esac
elif command -v xdpyinfo >/dev/null 2>&1; then
  dims="$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2; exit}')"
  case "$dims" in *x*) SCREEN_W="${dims%%x*}"; SCREEN_H="${dims##*x}" ;; esac
fi
log "screen ${SCREEN_W}x${SCREEN_H}"

# ---------------------------------------------------------------- openbox cfg
write_openbox_config() {
  OB_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/openbox"
  mkdir -p "$OB_DIR"
  if [ -f "$OB_DIR/rc.xml" ] && ! grep -q "minerva-generated" "$OB_DIR/rc.xml" 2>/dev/null; then
    cp "$OB_DIR/rc.xml" "$OB_DIR/rc.xml.pre-minerva" 2>/dev/null
  fi
  cat >"$OB_DIR/rc.xml" <<RCEOF
<?xml version="1.0" encoding="UTF-8"?>
<!-- minerva-generated: rewritten at every login by /usr/bin/minerva-session -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance><strength>10</strength><screen_edge_strength>20</screen_edge_strength></resistance>
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse><focusLast>yes</focusLast><raiseOnFocus>yes</raiseOnFocus></focus>
  <theme><name>Minerva</name><titleLayout>C</titleLayout><keepBorder>yes</keepBorder><hideDisabled>no</hideDisabled><animateIconify>no</animateIconify></theme>
  <desktops><number>4</number><firstdesk>1</firstdesk><names><name>1</name><name>2</name><name>3</name><name>4</name></names></desktops>
  <resize><popupShow>Nonpixel</popupShow><popupPosition>Center</popupPosition></resize>
  <margins><top>0</top><bottom>0</bottom><left>0</left><right>0</right></margins>
  <keyboard>
    <keybind key="A-Tab"><action name="NextWindow"><allDesktops>yes</allDesktops></action></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow"><allDesktops>yes</allDesktops></action></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="Super_L"><action name="Execute"><command>minerva-ctl event launcher</command></action></keybind>
    <keybind key="Super_R"><action name="Execute"><command>minerva-ctl event launcher</command></action></keybind>
    <keybind key="W-space"><action name="ShowMenu"><menu>root-menu</menu></action></keybind>
    <keybind key="C-A-T"><action name="Execute"><command>minerva-ctl app terminal</command></action></keybind>
    <keybind key="W-t"><action name="Execute"><command>minerva-ctl app terminal</command></action></keybind>
    <keybind key="W-e"><action name="Execute"><command>minerva-ctl app files</command></action></keybind>
    <keybind key="W-w"><action name="Execute"><command>minerva-ctl app web</command></action></keybind>
    <keybind key="W-d"><action name="ToggleShowDesktop"/></keybind>
    <keybind key="W-l"><action name="Execute"><command>minerva-ctl cmd lock</command></action></keybind>
    <keybind key="W-Left"><action name="GoToDesktop"><to>previous</to></action></keybind>
    <keybind key="W-Right"><action name="GoToDesktop"><to>next</to></action></keybind>
    <keybind key="Print"><action name="Execute"><command>sh -c "mkdir -p \$HOME/Pictures/Screenshots &amp;&amp; scrot \$HOME/Pictures/Screenshots/minerva-%Y%m%d-%H%M%S.png 2>/dev/null || import -window root \$HOME/Pictures/Screenshots/minerva-%Y%m%d-%H%M%S.png 2>/dev/null || true"</command></action></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>sh -c "pactl set-sink-volume @DEFAULT_SINK@ +5% 2>/dev/null || amixer -q set Master 5%+"</command></action></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>sh -c "pactl set-sink-volume @DEFAULT_SINK@ -5% 2>/dev/null || amixer -q set Master 5%-"</command></action></keybind>
    <keybind key="XF86AudioMute"><action name="Execute"><command>sh -c "pactl set-sink-mute @DEFAULT_SINK@ toggle 2>/dev/null || amixer -q set Master toggle"</command></action></keybind>
  </keyboard>
  <mouse>
    <context name="Frame">
      <mousebind button="A-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
    </context>
  </mouse>
  <applications>
    <!-- the fullscreen shell surface: never decorated, never in the taskbar,
         always underneath real app windows (matched by WM_CLASS or title) -->
    <application name="minerva-shell" class="minerva-shell">
      <decor>no</decor><layer>below</layer>
      <skip_taskbar>yes</skip_taskbar><skip_pager>yes</skip_pager>
    </application>
    <application title="Minerva">
      <decor>no</decor><layer>below</layer>
      <skip_taskbar>yes</skip_taskbar><skip_pager>yes</skip_pager>
    </application>
  </applications>
</openbox_config>
RCEOF
  if [ -f "$SHAREDIR/openbox/menu.xml" ] && [ ! -f "$OB_DIR/menu.xml" ]; then
    cp "$SHAREDIR/openbox/menu.xml" "$OB_DIR/menu.xml"
  fi
  write_openbox_theme
  log "openbox config written to $OB_DIR"
}

