# Keeps the fullscreen shell surface pinned no matter what any client does:
# below every app window, fullscreen, out of taskbar/pager. Re-applied every
# few seconds via EWMH so a missed WM rule or a chromium quirk can never
# unpin it. This is the belt-and-braces the earlier releases were missing.
enforce_shell_surface() {
  command -v wmctrl >/dev/null 2>&1 || { log "enforcer: wmctrl missing, skipped"; return 0; }
  command -v xprop >/dev/null 2>&1 || { log "enforcer: xprop missing, skipped"; return 0; }
  sleep 2
  while :; do
    for id in $(xprop -root _NET_CLIENT_LIST 2>/dev/null | tr ',' '\n' | sed -n 's/.*#x\?\([0-9a-fA-F]*\).*/\1/p'); do
      t="$(xprop -id 0x$id _NET_WM_NAME 2>/dev/null | sed -n 's/.*"\(.*\)".*/\1/p' | head -1)"
      if [ "$t" = "Minerva" ]; then
        wmctrl -i -r 0x$id -b add,below,skip_taskbar,skip_pager 2>/dev/null
        wmctrl -i -r 0x$id -b add,fullscreen 2>/dev/null
      fi
    done
    sleep 3
  done
}

# ------------------------------------------------------------------- daemon
start_daemon
watch_daemon() {
  while :; do
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      log "daemon died — restarting"
      start_daemon
    fi
    sleep 2
  done
}
watch_daemon &
WATCH_PID=$!

i=0
while [ "$i" -lt 50 ]; do
  if command -v curl >/dev/null 2>&1; then
    curl -fsS -o /dev/null "http://$BIND:$PORT/api/v1/health" 2>/dev/null && break
  else
    [ "$i" -ge 10 ] && break
  fi
  i=$((i + 1)); sleep 0.2
done
[ "$i" -lt 50 ] || log "warning: daemon not healthy after 10 s"

CHROME_FLAGS="--no-first-run --no-default-browser-check --disable-session-crashed-bubble --disable-dev-shm-usage --password-store=basic --disable-translate --check-for-update-interval=31536000"

# The single fullscreen shell surface. --kiosk makes chromium fullscreen by
# itself on any stack, so no window-manager cooperation is required for the
# desktop surface to cover the screen correctly.
shell_window() {
  log "shell surface: $BROWSER --kiosk $URL"
  case "$(basename "$BROWSER")" in
    chromium|chromium-browser)
      "$BROWSER" --kiosk --wm-class=minerva-shell --class=minerva-shell "$URL" \
        --user-data-dir="$SHELL_PROFILE" $CHROME_FLAGS >>"$LOG" 2>&1 &
      SHELL_PID=$! ;;
    firefox-esr|firefox)
      "$BROWSER" --kiosk "$URL" >>"$LOG" 2>&1 &
      SHELL_PID=$! ;;
    *)
      "$BROWSER" "$URL" >>"$LOG" 2>&1 &
      SHELL_PID=$! ;;
  esac
}

if [ "$MULTIWIN" = yes ]; then
  MINERVA_SESSION_MODE=x11
  export MINERVA_SESSION_MODE MINERVA_BROWSER="$BROWSER" MINERVA_SESSION_PID=$$
  log "session mode: x11 (openbox + fullscreen shell surface + real app windows)"
  # Clean up stale EWMH root properties left by the display manager or a
  # previous WM (proven step from openbox-session).
  xprop -root -remove _NET_NUMBER_OF_DESKTOPS \
        -remove _NET_DESKTOP_NAMES \
        -remove _NET_CURRENT_DESKTOP 2>/dev/null
  write_openbox_config
  start_wm() {
    # --startup is the stock openbox hook: minerva-autostart runs once the
    # WM is ready, exactly where a plain openbox session runs its autostart.
    openbox --sm-disable --startup "minerva-autostart" >>"$LOG" 2>&1 &
    WM_PID=$!
    echo "$WM_PID" >"$STATE/wm.pid"
  }
  start_wm
  sleep 0.5
  if ! kill -0 "$WM_PID" 2>/dev/null; then
    log "FATAL?: openbox exited immediately - retrying once"
    start_wm
    sleep 0.5
    kill -0 "$WM_PID" 2>/dev/null || log "FATAL: openbox not running; app windows unmanaged"
  fi
  log "openbox pid=$WM_PID"
  watch_wm() {
    while :; do
      pid="$(cat "$STATE/wm.pid" 2>/dev/null || true)"
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
        log "openbox died - restarting with autostart hook"
        start_wm
      fi
      sleep 2
    done
  }
  watch_wm &
  WM_WATCH_PID=$!
  # paint the root window before the shell surface maps (no flash of grey)
  xsetroot -solid '#0b1020' 2>/dev/null
  shell_window
  enforce_shell_surface &
  ENFORCE_PID=$!
  log "shell-surface enforcer pid=$ENFORCE_PID"
else
  MINERVA_SESSION_MODE=kiosk
  export MINERVA_SESSION_MODE MINERVA_BROWSER="$BROWSER" MINERVA_SESSION_PID=$$
  log "session mode: kiosk single-window ($BROWSER)"
  case "$(basename "$BROWSER")" in
    chromium|chromium-browser) shell_window ;;
    firefox-esr|firefox) shell_window ;;
    *)
      if [ -n "${DISPLAY:-}" ]; then
        shell_window
      elif command -v cage >/dev/null 2>&1; then
        cage -- "$BROWSER" "$URL" >>"$LOG" 2>&1 & SHELL_PID=$!
      elif command -v weston >/dev/null 2>&1; then
        weston --socket=minerva -- "$BROWSER" "$URL" >>"$LOG" 2>&1 & SHELL_PID=$!
      else
        echo "Minerva: no compositor. sudo apt install cage" >&2
        exit 1
      fi ;;
  esac
fi

# A crashed shell surface must not throw the user back to the login screen:
# respawn it a few times. Logout paths set EXITING via the cleanup trap.
shell_tries=0
EXIT_CODE=0
while :; do
  wait "$SHELL_PID"
  EXIT_CODE=$?
  [ "$EXITING" = yes ] && break
  shell_tries=$((shell_tries + 1))
  if [ "$shell_tries" -ge 4 ]; then
    log "shell surface failed $shell_tries times — giving up"
    break
  fi
  log "shell surface exited code=$EXIT_CODE — respawning (try $shell_tries)"
  sleep 1
  shell_window
done
log "session exit code=$EXIT_CODE"
exit "$EXIT_CODE"
