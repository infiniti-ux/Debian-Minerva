#!/bin/sh
# minerva-ctl — talk to the running Minerva session daemon.
# Used by openbox keybinds, the root menu, and anything that needs to open a
# Minerva panel or launch a real app from outside the shell windows.
set -u

RT="${XDG_RUNTIME_DIR:-/tmp}/minerva"
ENVF="$RT/session.env"

if [ ! -f "$ENVF" ]; then
  echo "minerva-ctl: no Minerva session running" >&2
  exit 1
fi
# shellcheck disable=SC1090
. "$ENVF"

if ! command -v curl >/dev/null 2>&1; then
  echo "minerva-ctl: curl is required" >&2
  exit 1
fi

post() {
  curl -s -X POST "$MINERVA_API/exec" \
    -H "Content-Type: application/json" \
    -H "X-Minerva-Token: $MINERVA_TOKEN" \
    -d "$1" >/dev/null
}

# ---- native WM channel (v0.11.0) -------------------------------------------
# minerva-wm watches the root property _MINERVA_WM_CMD; xprop is enough to
# drive the native shell. The daemon POST stays as the fallback for the
# legacy bases and for commands only the daemon implements (apps, windows).
wm_cmd() {
  command -v xprop >/dev/null 2>&1 || return 1
  xprop -root _MINERVA_SUPPORTING 2>/dev/null | grep -q 'minerva-wm' || return 1
  xprop -root -f _MINERVA_WM_CMD 8s -set _MINERVA_WM_CMD "$1" >/dev/null 2>&1
}

native_for() {
  case "$1/$2" in
    panel/launcher|event/launcher|event/overview) echo launcher ;;
    panel/settings|panel/topbar|panel/shade|panel/wifi|panel/audio|panel/battery|panel/calendar|panel/dock) echo qs ;;
    panel/power) echo power ;;
    cmd/lock) echo lock ;;
    cmd/logout) echo logout ;;
    cmd/reboot) echo reboot ;;
    cmd/shutdown) echo shutdown ;;
    cmd/showdesktop) echo showdesktop ;;
    *) echo "" ;;
  esac
}

route() {
  # $1 = native command (may be empty), $2 = daemon JSON fallback
  if [ -n "$1" ] && wm_cmd "$1"; then return 0; fi
  post "$2"
}

usage() {
  cat >&2 <<EOF
usage:
  minerva-ctl panel <launcher|wifi|audio|battery|calendar|power|shade|settings|topbar|dock>
  minerva-ctl app <id>            launch a real app (terminal, files, web, ...
                                  or a .desktop id like org.gnome.Calculator)
  minerva-ctl cmd <logout|lock|reboot|shutdown|showdesktop>
  minerva-ctl event <launcher|overview>   queue a shell event (Super key)
  minerva-ctl win <focus|close|minimize|restore> <window-id>
EOF
  exit 2
}

[ $# -ge 2 ] || usage

case "$1" in
  panel) route "$(native_for panel "$2")" "{\"panel\":\"$2\"}" ;;
  app) post "{\"desktop\":\"$2\",\"app\":\"$2\"}" ;;
  cmd)   route "$(native_for cmd "$2")" "{\"cmd\":\"$2\"}" ;;
  event) route "$(native_for event "$2")" "{\"event\":\"$2\"}" ;;
  win)   post "{\"win_op\":\"$2\",\"win_id\":\"${3:-}\"}" ;;
  *)     usage ;;
esac
