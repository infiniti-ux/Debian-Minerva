[Unit]
Description=Debian Minerva session daemon (headless / development)
Documentation=https://github.com/infiniti-ux/Debian-Minerva
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/minerva-sessiond --port 47801 --bind 127.0.0.1 --web-root /usr/share/minerva/web
Restart=always
RestartSec=1
WatchdogSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.config/debian-minerva

[Install]
WantedBy=default.target
