[Unit]
Description=Minerva notification daemon (dunst with the Aluminium dunstrc)
Documentation=man:dunst(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStartPre=/usr/bin/minerva-dunstrc
ExecStart=/usr/bin/dunst
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
