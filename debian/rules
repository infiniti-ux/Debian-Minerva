#!/usr/bin/make -f
export DH_VERBOSE = 1
export CARGO_HOME = $(CURDIR)/.cargo-dh
export CARGO_NET_OFFLINE = true

%:
	dh $@

override_dh_auto_build:
	cargo build --release --offline

override_dh_auto_test:
	cargo test --release --offline

override_dh_auto_install:
	install -Dm755 target/release/minerva-sessiond debian/debian-minerva/usr/bin/minerva-sessiond
	install -Dm755 session/minerva-session debian/debian-minerva/usr/bin/minerva-session
	install -Dm755 session/minerva-ctl debian/debian-minerva/usr/bin/minerva-ctl
	install -Dm755 session/minerva-doctor debian/debian-minerva/usr/bin/minerva-doctor
	install -Dm755 session/minerva-autostart debian/debian-minerva/usr/bin/minerva-autostart
	install -Dm755 session/minerva-shell-start debian/debian-minerva/usr/bin/minerva-shell-start
	install -Dm755 session/minerva-bootstrap debian/debian-minerva/usr/bin/minerva-bootstrap
	install -Dm755 session/minerva-verify debian/debian-minerva/usr/bin/minerva-verify
	install -Dm755 session/minerva-dunstrc debian/debian-minerva/usr/bin/minerva-dunstrc
	install -Dm755 session/minerva-trace debian/debian-minerva/usr/bin/minerva-trace
	install -Dm644 session/xresources debian/debian-minerva/usr/share/minerva/xresources
	mkdir -p debian/debian-minerva/usr/share/themes
	cp -a theme/Minerva debian/debian-minerva/usr/share/themes/Minerva
	mkdir -p debian/debian-minerva/usr/share/minerva/web
	cp -r web/. debian/debian-minerva/usr/share/minerva/web/
	install -Dm644 session/openbox/menu.xml debian/debian-minerva/usr/share/minerva/openbox/menu.xml
	install -Dm644 session/minerva.desktop debian/debian-minerva/usr/share/xsessions/minerva.desktop
	install -Dm644 packaging/minerva-sessiond.service debian/debian-minerva/usr/lib/systemd/user/minerva-sessiond.service
	install -Dm644 packaging/minerva-dunst.service debian/debian-minerva/usr/lib/systemd/user/minerva-dunst.service
	install -Dm644 packaging/minerva-parcellite.service debian/debian-minerva/usr/lib/systemd/user/minerva-parcellite.service
	install -Dm644 packaging/minerva-polkit.service debian/debian-minerva/usr/lib/systemd/user/minerva-polkit.service
	install -Dm644 packaging/90-minerva.preset debian/debian-minerva/usr/lib/systemd/user-preset/90-minerva.preset
	install -Dm644 packaging/minerva-portals.conf debian/debian-minerva/usr/share/xdg-desktop-portal/minerva-portals.conf

override_dh_auto_clean:
	cargo clean
	rm -rf .cargo-dh
